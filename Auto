    Btn.TextSize = 12
    Btn.AutoButtonColor = false
    Btn.Parent = MainFrame

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 10)
    Corner.Parent = Btn

    local Stroke = Instance.new("UIStroke")
    Stroke.Thickness = 1.5
    Stroke.Color = defaultState and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(220, 80, 80)
    Stroke.Parent = Btn

    local state = defaultState

    Btn.MouseEnter:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.2), {Size = UDim2.new(0.91, 0, 0, 37), Position = UDim2.new(0.045, 0, 0, yOffset - 1)}):Play()
    end)
    Btn.MouseLeave:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.2), {Size = UDim2.new(0.88, 0, 0, 35), Position = UDim2.new(0.06, 0, 0, yOffset)}):Play()
    end)

    Btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            Btn.Text = text .. " [ON]"
            Btn.TextColor3 = Color3.fromRGB(80, 255, 140)
            Stroke.Color = Color3.fromRGB(80, 255, 140)
            Btn.BackgroundColor3 = Color3.fromRGB(20, 50, 35)
