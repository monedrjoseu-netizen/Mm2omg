local function createToggleButton(name, text, yOffset, defaultState, callback)
    local Btn = Instance.new("TextButton")
    Btn.Name = name
    Btn.Size = UDim2.new(0.88, 0, 0, 35)
    Btn.Position = UDim2.new(0.06, 0, 0, yOffset)
    Btn.BackgroundColor3 = defaultState and Color3.fromRGB(20, 50, 35) or Color3.fromRGB(22, 22, 32)
    Btn.Font = Enum.Font.GothamBold
    Btn.Text = text .. (defaultState and " [ON]" or " [OFF]")
