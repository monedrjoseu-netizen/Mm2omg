-- 9. MAIN RENDER LOOP
----------------------------------------------------
local lastShotTime = 0

RunService.RenderStepped:Connect(function()
    -- Out of Map Loop (Paused automatically when Auto Win is actively executing)
    if Settings.OutOftheMap and not isAutoWinning and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        hrp.CFrame = CFrame.new(hrp.Position.X, 500, hrp.Position.Z)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end

    -- ESP Loop
    if Settings.EspEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local role = checkRole(player)
                if role == "Murderer" then
                    applyHighlight(player, Color3.fromRGB(255, 30, 30))
                elseif role == "Sheriff" then
                    applyHighlight(player, Color3.fromRGB(0, 150, 255))
                else
                    removeHighlight(player)
                end
            end
        end
    end

    -- Kill Aura Loop
    executeKillAura()

    -- Aimlock & Auto-Shoot Loop
    local target = nil
    if Settings.AimlockMurderer then
        target = getAimbotTarget("Murderer")
    elseif Settings.AimlockSheriff then
        target = getAimbotTarget("Sheriff")
    end

    if target and target.Character and target.Character:FindFirstChild("Head") then
        local headPos = target.Character.Head.Position
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, headPos)

        if Settings.AutoShoot and LocalPlayer.Character then
            local gun = LocalPlayer.Character:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun")
            if gun and (tick() - lastShotTime >= 0.1) then
                lastShotTime = tick()
                if gun.Parent == LocalPlayer.Backpack then
                    gun.Parent = LocalPlayer.Character
                end
                gun:Activate()
                local shootRemote = gun:FindFirstChild("Shoot") or gun:FindFirstChild("ServerControl")
                if shootRemote and shootRemote:IsA("RemoteEvent") then
                    shootRemote:FireServer(headPos)
                end
            end
        end
    end
end)
