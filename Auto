-- 7. AUTO WIN LOGIC (FIXED CONFLICT WITH OUT-OF-MAP)
----------------------------------------------------
local isAutoWinning = false

task.spawn(function()
    while true do
        task.wait(0.3)
        if Settings.AutoWin and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local myRole = checkRole(LocalPlayer)
            local hrp = LocalPlayer.Character.HumanoidRootPart
            
            local gun = LocalPlayer.Character:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun")
            local knife = LocalPlayer.Character:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")

            if myRole == "Murderer" and knife then
                isAutoWinning = true
                for _, enemy in ipairs(Players:GetPlayers()) do
                    if enemy ~= LocalPlayer and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
                        hrp.CFrame = enemy.Character.HumanoidRootPart.CFrame + Vector3.new(0, 0, 2)
                        knife.Parent = LocalPlayer.Character
                        knife:Activate()
                        task.wait(0.1)
                    end
                end
                isAutoWinning = false
            elseif myRole == "Sheriff" and gun then
                for _, enemy in ipairs(Players:GetPlayers()) do
                    if enemy ~= LocalPlayer and checkRole(enemy) == "Murderer" and enemy.Character and enemy.Character:FindFirstChild("Head") then
                        isAutoWinning = true
                        gun.Parent = LocalPlayer.Character
                        hrp.CFrame = enemy.Character.HumanoidRootPart.CFrame + Vector3.new(0, 0, 3)
                        local headPos = enemy.Character.Head.Position
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, headPos)
                        
                        gun:Activate()
                        local shootRemote = gun:FindFirstChild("Shoot") or gun:FindFirstChild("ServerControl")
                        if shootRemote and shootRemote:IsA("RemoteEvent") then
                            shootRemote:FireServer(headPos)
                        end
                        task.wait(0.5)
                        isAutoWinning = false
                        break
                    end
                end
            end
        end
    end
end)

