-- 4. ROLE ESP & AIMBOT UTILITIES
----------------------------------------------------
local function removeHighlight(player)
    if player.Character and player.Character:FindFirstChild("MM2_Highlight") then
        player.Character.MM2_Highlight:Destroy()
    end
end

local function applyHighlight(player, color)
    if not player.Character then return end
    local highlight = player.Character:FindFirstChild("MM2_Highlight")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "MM2_Highlight"
        highlight.FillTransparency = 0.45
        highlight.OutlineTransparency = 0
        highlight.Parent = player.Character
    end
    highlight.FillColor = color
    highlight.OutlineColor = color
end

local function checkRole(player)
    if not player.Character then return nil end
    local backpack = player:FindFirstChildOfClass("Backpack")
    local items = {}
    if backpack then for _, v in ipairs(backpack:GetChildren()) do table.insert(items, v) end end
    for _, v in ipairs(player.Character:GetChildren()) do table.insert(items, v) end

    for _, item in ipairs(items) do
        if item:IsA("Tool") then
            if item.Name == "Knife" or item:FindFirstChild("Knife") then
                return "Murderer"
            elseif item.Name == "Gun" or item:FindFirstChild("Gun") then
                return "Sheriff"
            end
        end
    end
    return "Innocent"
end

local function getAimbotTarget(targetRole)
    local targetPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            if checkRole(player) == targetRole then
                local head = player.Character.Head
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local mousePos = UserInputService:GetMouseLocation()
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if distance < Settings.AimFOV and distance < shortestDistance then
                        shortestDistance = distance
                        targetPlayer = player
                    end
                end
            end
        end
    end
    return targetPlayer
end

----------------------------------------------------
-- 5. KILL AURA LOGIC (SAFE: MURDERER ONLY)
----------------------------------------------------
local lastAuraAttack = 0

local function executeKillAura()
    if not Settings.KillAura then return end
    local myRole = checkRole(LocalPlayer)
    if myRole ~= "Murderer" then return end

    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    local tool = character:FindFirstChildOfClass("Tool")
    if not tool or tool.Name ~= "Knife" then return end

    local hrp = character.HumanoidRootPart

    for _, enemy in ipairs(Players:GetPlayers()) do
        if enemy ~= LocalPlayer and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
            local enemyHrp = enemy.Character.HumanoidRootPart
            local distance = (hrp.Position - enemyHrp.Position).Magnitude

            if distance <= Settings.KillAuraRange then
                local currentTime = tick()
                if currentTime - lastAuraAttack > 0.3 then
                    lastAuraAttack = currentTime
                    tool:Activate()
                    local remote = tool:FindFirstChild("Stab") or tool:FindFirstChild("ServerControl")
                    if remote and remote:IsA("RemoteEvent") then
                        remote:FireServer(enemyHrp.Position)
                    end
                end
            end
        end
    end
end

